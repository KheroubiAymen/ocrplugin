{
    "name": "swissdidata/ocrplugin",
    "description": "OCR — extract text from uploaded PDFs and images using OpenAI vision, for DiData",
    "require": {
        "didata/installer": "@dev"
    },
    "autoload": {
        "psr-4": {
            "SwissDidata\\Ocr\\": "src"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "SwissDidata\\Ocr\\OcrPackage"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
